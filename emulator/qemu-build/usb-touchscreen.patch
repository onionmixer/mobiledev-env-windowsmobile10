+static int usb_hid_pointer_poll(USBHIDState *us, uint8_t *data, int length)
+{
+    uint8_t tablet[8] = {0};
+    uint8_t report[10];
+    uint16_t scan_time;
+
+    if (!us->touchscreen) {
+        return hid_pointer_poll(&us->hid, data, length);
+    }
+    hid_pointer_poll(&us->hid, tablet, sizeof(tablet));
+    report[0] = 1;
+    /* Keep Confidence set through lift: clearing it cancels a Windows tap. */
+    report[1] = 4 | ((tablet[0] & 1) ? 3 : 0);
+    report[2] = 0;
+    memcpy(report + 3, tablet + 1, 4);
+    scan_time = qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) * 10;
+    report[7] = scan_time & 0xff;
+    report[8] = scan_time >> 8;
+    report[9] = 1; /* Includes the final tip-up report for the contact. */
+    length = MIN(length, sizeof(report));
+    memcpy(data, report, length);
+    return length;
+}
