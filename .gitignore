# Downloaded SDK, guest state, vendored checkouts and generated builds.
/emulator/third_party/
/emulator/artifacts/
/emulator/runtime/
/emulator/build/
/emulator/build-archive/

# Local evidence stays on disk. Commit its documentation and hash index only.
/docs/evidence/**
!/docs/evidence/**/
!/docs/evidence/**/README.md
!/docs/evidence/**/index.json
/docs/reorganization/*.png
/docs/reorganization/*.ppm
/docs/reorganization/*.json

